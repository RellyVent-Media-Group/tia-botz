# ChiefPilot Social Media Platform Configuration

# API Configuration
API_PORT=3000
API_HOST=localhost

# Redis Configuration (for BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL Configuration (for Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/chiefpilot_social

# Platform API Keys
INSTAGRAM_API_KEY=
INSTAGRAM_API_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

TIKTOK_API_KEY=
TIKTOK_API_SECRET=
TIKTOK_ACCESS_TOKEN=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

TELEGRAM_BOT_TOKEN=

DISCORD_BOT_TOKEN=

# Character API Configuration
CHARACTER_API_URL=http://localhost:8001
CHARACTER_API_KEY=

# Rate Limiting
DEFAULT_RATE_LIMIT_RPM=30
DEFAULT_RATE_LIMIT_RPH=1000

# Retry Policy
DEFAULT_MAX_RETRIES=3
DEFAULT_BACKOFF_MS=1000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
NODE_ENV=development
