# ========================================
# CORE API CREDENTIALS
# ========================================

# Portfolio Management System
PORTFOLIO_API_KEY=your_portfolio_api_key
PORTFOLIO_API_SECRET=your_portfolio_api_secret
PORTFOLIO_API_URL=https://api.portfolio.example.com

# Trading Platform
TRADING_API_KEY=your_trading_api_key
TRADING_API_SECRET=your_trading_api_secret
TRADING_API_URL=https://api.trading.example.com

# Market Data Provider
MARKET_DATA_API_KEY=your_market_data_api_key
MARKET_DATA_API_URL=https://api.marketdata.example.com

# ========================================
# PARTNER DEPOT INTEGRATIONS
# ========================================

# Consort Depot (TZI.CNS.DEP.CONSORT)
CONSORT_API_URL=https://api.consort.tzi.internal
CONSORT_API_KEY=your_consort_api_key_here

# CashingHouse Depot (TZI.CSH.DEP.CASHING)
CASHINGHOUSE_API_URL=https://api.cashinghouse.tzi.internal
CASHINGHOUSE_API_KEY=your_cashinghouse_api_key_here

# Scribe Depot (TZI.SCR.DEP.BODY)
SCRIBE_API_URL=https://api.scribe.tzi.internal
SCRIBE_API_KEY=your_scribe_api_key_here

# ========================================
# DATABASE CONFIGURATION
# ========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=holdings_depot
DB_USER=holdings_user
DB_PASSWORD=secure_password_here

# ========================================
# NOTIFICATION SETTINGS
# ========================================

# Email Notifications
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=notifications@example.com
EMAIL_PASSWORD=email_password_here
EMAIL_FROM=holdings-depot@example.com
EMAIL_TO=team@example.com

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ENABLED=true

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false

# SMS Integration (Twilio or similar)
SMS_ENABLED=false
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_FROM_NUMBER=+1234567890
SMS_TO_NUMBER=+0987654321

# ========================================
# AUTOMATION SETTINGS
# ========================================

# Execution Mode
DRY_RUN=true  # Set to false for live trading
DRY_RUN_CONFIRMATION=true  # Require confirmation before live trades

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_MAX_SIZE=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=5

# Timezone
TIMEZONE=UTC

# ========================================
# SECURITY SETTINGS
# ========================================

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# Request Timeout
REQUEST_TIMEOUT=30  # seconds

# Retry Configuration
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2

# ========================================
# RISK MANAGEMENT
# ========================================

# Risk Limits
MAX_DAILY_TRADES=50
MAX_POSITION_SIZE=100000
MAX_DAILY_LOSS=5000
EMERGENCY_STOP_ENABLED=true

# Risk Alerts
RISK_ALERT_ENABLED=true
RISK_ALERT_THRESHOLD_CRITICAL=0.9
RISK_ALERT_THRESHOLD_HIGH=0.7
RISK_ALERT_THRESHOLD_MEDIUM=0.5

# ========================================
# SCHEDULING
# ========================================

# Portfolio Rebalancing Schedule
REBALANCE_ENABLED=true
REBALANCE_SCHEDULE=0 16 * * 5  # Weekly Friday 4 PM UTC

# Resource Allocation Schedule
ALLOCATION_ENABLED=true
ALLOCATION_SCHEDULE=0 9 * * *  # Daily 9 AM UTC

# Risk Monitoring Schedule
RISK_MONITORING_ENABLED=true
RISK_MONITORING_SCHEDULE=*/5 * * * *  # Every 5 minutes

# Report Generation Schedule
REPORT_ENABLED=true
REPORT_SCHEDULE=0 18 * * *  # Daily 6 PM UTC

# ========================================
# BACKUP AND MAINTENANCE
# ========================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily 2 AM UTC
BACKUP_RETENTION_DAYS=30
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_PATH=/remote/backups/holdings-depot

# Maintenance Schedule
MAINTENANCE_ENABLED=true
MAINTENANCE_SCHEDULE=0 3 * * 0  # Weekly Sunday 3 AM UTC
LOG_ROTATION_ENABLED=true
LOG_ROTATION_SCHEDULE=0 1 * * *  # Daily 1 AM UTC

# ========================================
# MONITORING
# ========================================

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_INTERVAL=60  # seconds

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_ALERT_CPU_THRESHOLD=80
PERFORMANCE_ALERT_MEMORY_THRESHOLD=80
PERFORMANCE_ALERT_DISK_THRESHOLD=80

# ========================================
# TESTING
# ========================================

# Test Mode
TEST_MODE=false
TEST_DATA_PATH=./data/test
TEST_REPORT_PATH=./results/test

# ========================================
# DEVELOPMENT
# ========================================

# Debug Mode
DEBUG=false
DEBUG_OUTPUT_FILE=logs/debug.log

# Development Mode
DEV_MODE=false
DEV_HOT_RELOAD=false