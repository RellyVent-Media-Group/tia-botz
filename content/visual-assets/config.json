{
  "ai_services": {
    "dalle": {
      "enabled": true,
      "priority": 1,
      "api_key_env": "OPENAI_API_KEY",
      "model": "dall-e-3",
      "quality": "standard",
      "supported_sizes": ["1024x1024", "1024x1792", "1792x1024"],
      "default_size": "1024x1024",
      "max_retries": 3,
      "timeout": 60,
      "cost_per_image": 0.04
    },
    "stable_diffusion": {
      "enabled": true,
      "priority": 2,
      "api_url": "http://127.0.0.1:7860/sdapi/v1/txt2img",
      "default_steps": 20,
      "default_cfg_scale": 7,
      "default_sampler": "Euler a",
      "max_retries": 3,
      "timeout": 120,
      "cost_per_image": 0.0
    },
    "midjourney": {
      "enabled": true,
      "priority": 3,
      "api_url": "https://api.midjourney.com/v2",
      "discord_bot_token": "",
      "discord_channel_id": "",
      "max_retries": 3,
      "timeout": 180,
      "cost_per_image": 0.0
    }
  },
  "generation_settings": {
    "fallback_enabled": true,
    "fallback_order": ["dalle", "stable-diffusion", "midjourney"],
    "parallel_generation": false,
    "batch_size": 5,
    "quality_threshold": 0.7,
    "auto_retry": true,
    "save_failed_prompts": true
  },
  "output_settings": {
    "default_format": "jpg",
    "jpeg_quality": 95,
    "create_thumbnails": true,
    "thumbnail_size": "200x200",
    "add_metadata": true,
    "backup_enabled": true,
    "backup_location": "./backups"
  },
  "platform_defaults": {
    "crackrevenue": {
      "preferred_service": "dalle",
      "quality": "high"
    },
    "telegram": {
      "preferred_service": "stable-diffusion",
      "quality": "medium"
    },
    "whatsapp": {
      "preferred_service": "dalle",
      "quality": "high"
    },
    "google": {
      "preferred_service": "dalle",
      "quality": "high"
    },
    "admob": {
      "preferred_service": "stable-diffusion",
      "quality": "medium"
    },
    "instagram": {
      "preferred_service": "midjourney",
      "quality": "high"
    },
    "tiktok": {
      "preferred_service": "midjourney",
      "quality": "high"
    },
    "multi-platform": {
      "preferred_service": "dalle",
      "quality": "high"
    }
  }
}