# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Character API Configuration (update this to your Vercel URL)
CHARACTER_API_URL=https://vercel-character-api.vercel.app

# Database Configuration (Railway will use ephemeral storage or you can add a database service)
DATABASE_PATH=/tmp/chiefpilot.db

# Node Environment
NODE_ENV=production