# Tiapmaatzu OS Toolkit - Master Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with secrets to version control

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# WHATSAPP BOT CONFIGURATION
# ============================================
# WhatsApp Business API credentials
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token

# ============================================
# SOCIAL MEDIA AUTOMATION
# ============================================
# Instagram credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_API_KEY=your_instagram_api_key

# TikTok credentials
TIKTOK_USERNAME=your_tiktok_username
TIKTOK_PASSWORD=your_tiktok_password
TIKTOK_API_KEY=your_tiktok_api_key

# Posting frequency (posts per week)
POST_FREQUENCY_INSTAGRAM=3
POST_FREQUENCY_TIKTOK=2

# ============================================
# NOTION INTEGRATION
# ============================================
NOTION_API_KEY=your_notion_integration_token
NOTION_CHARACTER_DATABASE_ID=your_character_database_id
NOTION_CONTENT_CALENDAR_ID=your_content_calendar_id
NOTION_TASK_DATABASE_ID=your_task_database_id
NOTION_USER_ID=your_notion_user_id

# Sync configuration
AUTO_SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=30

# ============================================
# CHARACTER DATABASE & ASSETS
# ============================================
# Standardized paths for shared resources
CHARACTER_DATABASE_PATH=/Users/jypsee72/Desktop/Tiapmaatzu-OS-Toolkit/core/integration-hub/Private & Shared/characters-cleaned.json
CHARACTER_API_URL=http://localhost:8001
VISUAL_ASSETS_PATH=/Users/jypsee72/Desktop/Tiapmaatzu-OS-Toolkit/content/visual-assets
CONTENT_CALENDAR_PATH=/Users/jypsee72/Desktop/Tiapmaatzu-OS-Toolkit/core/character-database/Content Calendar
TASK_LIST_PATH=/Users/jypsee72/Desktop/Tiapmaatzu-OS-Toolkit/core/character-database/Task List

# ============================================
# AI IMAGE GENERATION
# ============================================
# Midjourney configuration
MIDJOURNEY_API_KEY=your_midjourney_api_key
MIDJOURNEY_WEBHOOK_URL=your_webhook_url

# Stable Diffusion configuration
STABLE_DIFFUSION_API_KEY=your_stable_diffusion_api_key
STABLE_DIFFUSION_API_URL=https://api.stability.ai

# OpenAI DALL-E configuration
OPENAI_API_KEY=your_openai_api_key

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key

# ============================================
# SUBSCRIPTION & PAYMENT
# ============================================
SUBSCRIPTION_PRICE_MONTHLY=9.99
SUBSCRIPTION_PRICE_YEARLY=99.99
GUMROAD_PRODUCT_ID=your_gumroad_product_id

# ============================================
# WORKSPACE / INTEGRATION HUB
# ============================================
WORKSPACE_API_URL=http://localhost:8080
WORKSPACE_API_KEY=your_workspace_api_key

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite database path for bot shared modules
DATABASE_PATH=/Users/jypsee72/Desktop/Tiapmaatzu-OS-Toolkit/bots/shared/chiefpilot.db

# PostgreSQL for integration hub (if using)
DATABASE_URL=postgresql://user:password@localhost:5432/tiapmaatzu_os

# ============================================
# WEB APPLICATION CONFIGURATION
# ============================================
# ChiefPilot web app
VITE_API_URL=http://localhost:8080
VITE_AUTH_ENABLED=false

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn

# ============================================
# TZU ORGANIZATIONAL SYSTEM
# ============================================
# Heart Calendar
HEART_CALENDAR_API_KEY=your_heart_calendar_api_key

# Stakeholder tracking
STAKEHOLDER_TRACKING_ENABLED=true

# Depot automation
DEPOT_HIERARCHY_EXECUTIVE=executive_depot_id
DEPOT_HIERARCHY_CONSORT=consort_depot_id
DEPOT_HIERARCHY_SCRIBE=scribe_depot_id
DEPOT_HIERARCHY_CASHINGHOUSE=cashinghouse_depot_id
DEPOT_HIERARCHY_HOLDINGS=holdings_depot_id

# ============================================
# PLATFORM ASSIGNMENTS
# ============================================
PLATFORM_TIKTOK_ENABLED=true
PLATFORM_INSTAGRAM_ENABLED=true
PLATFORM_YOUTUBE_ENABLED=true
PLATFORM_X_ENABLED=true
PLATFORM_GUMROAD_ENABLED=true
PLATFORM_FIVERR_ENABLED=true
PLATFORM_ADMOB_ENABLED=true
PLATFORM_LINKTREE_ENABLED=true
PLATFORM_WHATSAPP_ENABLED=true
PLATFORM_TELEGRAM_ENABLED=true

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
NODE_ENV=development
DEBUG=false
